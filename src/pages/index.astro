---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Interferenze - Fisica, Matematica e Informatica">
	<Header />
	
	<main class="hero-container">
		<img src="/hero.jpeg" alt="Interferenze" class="hero-image" width="200"/>
		
		<h1>Benvenuti su <span class="accent"> Interferenze</span></h1>
		<p class="subtitle">Appunti leggeri di Fisica, Matematica e Informatica per menti curiose.</p>
	</main>
</Layout>

<style>
	body {
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		margin: 0;
		background-color: #f8fafc;
		color: #1e293b;
	}
	.hero-container {
		max-width: 800px;
		margin: 4rem auto;
		text-align: center;
		padding: 0 1rem;
	}
	.hero-image {
		width: 100%;
		max-width: 500px;
		height: auto;
		border-radius: 20px;
		box-shadow: 0 10px 25px rgba(0,0,0,0.1);
		margin-bottom: 2rem;
	}
	h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}
	.accent {
		color: #3b82f6;
	}
	.subtitle {
		font-size: 1.2rem;
		color: #64748b;
	}


	.hero-container {
  max-width: 800px;      /* Impedisce al contenuto di allargarsi troppo sui monitor grandi */
  margin: 4rem auto;     /* Centra la hero e lascia spazio dal menu */
  padding: 0 1.5rem;     /* Protegge i lati sui telefoni */
  display: flex;
  flex-direction: column;
  align-items: center;   /* Centra perfettamente tutti gli elementi in orizzontale */
}

.hero-image {
  width: 100%;           /* L'immagine è fluida... */
  max-width: 1000px;      /* ...ma non supererà mai i 450px di larghezza */
  height: 500px;         /* Altezza fissa per dare stabilità alla grafica */
  object-fit: cover;     /* Fondamentale! Ritaglia l'immagine senza distorcerla */
  border-radius: 24px;   /* Angoli molto arrotondati, stile moderno/app */
  box-shadow: 0 12px 30px rgba(59, 130, 246, 0.1); /* Ombra leggera azzurrata */
}
</style>