---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Interferenze - Note di Fisica, Matematica e Informatica">
	<Header />
	
	<main class="homepage-container">
		<!-- Sezione Introduttiva Testuale -->
		<section class="intro-section">
		<!-- 	<h1> Interferenze</h1>
			<p class="subtitle">Discipline scientifiche spiegate in modo semplice. Note sparse di fisica, matematica e informatica da un liceo.</p> -->
		</section>

		<!-- Immagine Centrale Responsiva -->
		<div class="hero-image-wrapper">
			<!-- Ricorda di mettere l'immagine in public/ e rinominarla o cambiare il src qui sotto -->
			<img src="/hero.jpeg" alt="Copertina Interferenze" class="responsive-hero-image" />
		</div>
	</main>
</Layout>

<style>
	body {
		background-color: #ffffff; /* Sfondo totalmente bianco per pulizia massima */
		margin: 0;
		color: #1a1a1a;
		-webkit-font-smoothing: antialiased;
	}

	.homepage-container {
		max-width: 680px; /* Larghezza tipica degli articoli di Substack, perfetta per la lettura */
		margin: 0 auto;
		padding: 3rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.intro-section {
		text-align: center;
	}

	h1 {
		font-family: Georgia, Cambria, "Times New Roman", Times, serif;
		font-size: 2.8rem;
		font-weight: 700;
		margin: 0 0 0.8rem 0;
		color: #1a1a1a;
		letter-spacing: -1px;
	}

	.subtitle {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		font-size: 1.15rem;
		line-height: 1.5;
		color: #666666;
		max-width: 540px;
		margin: 0 auto;
	}

	/* Il segreto dell'adattabilità al cellulare */
	.hero-image-wrapper {
		width: 100%;
		overflow: hidden;
		border-radius: 8px; /* Substack usa angoli vivi o appena accennati */
		border: 1px solid #e5e7eb; /* Bordino sottile per dare staccabilità all'immagine */
	}

	.responsive-hero-image {
		width: 100%;       /* Occupa tutto lo spazio disponibile sul telefono */
		height: auto;      /* Mantiene rigorosamente le proporzioni originali su ogni schermo */
		max-height: 400px; /* Evita che sui computer giganti diventi troppo alta */
		object-fit: cover; /* Gestisce il ritaglio matematico se incontra il limite di altezza */
		display: block;
	}

	/* Ottimizzazioni specifiche per schermi piccoli (Smartphone) */
	@media (max-width: 480px) {
		h1 {
			font-size: 2.2rem; /* Rimpicciolisce leggermente il titolo per non farlo andare troppo a capo */
		}
		.subtitle {
			font-size: 1.05rem;
		}
		.homepage-container {
			padding: 1.5rem 1rem; /* Riduce i margini per sfruttare tutto lo spazio del telefono */
		}
	}
</style>