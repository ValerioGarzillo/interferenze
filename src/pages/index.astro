---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// 1. Usiamo il nuovo metodo supportato da Astro e Vite per caricare i file Markdown
const postFiles = import.meta.glob('./blog/*.md', { eager: true });

// 2. Trasformiamo l'oggetto in un array e mappiamo i dati per estrarre url e frontmatter
const allPosts = Object.values(postFiles).map((post: any) => ({
  url: post.url,
  frontmatter: post.frontmatter,
}));

// 3. Prendiamo i primi 6 articoli per la homepage
const latestPosts = allPosts.slice(0, 6);
---

<Layout title="Interferenze - Note di Fisica, Matematica e Informatica">
	<Header />
	
	<main class="homepage-container">
		<section class="intro-section">
		{/* 	<h1>Interferenze</h1>
			<p class="subtitle">Discipline scientifiche spiegate in modo semplice. Note sparse di fisica, matematica e informatica da un liceo.</p> */}
		</section>

		<div class="hero-image-wrapper">
			<img src="/hero.jpeg" alt="Copertina Interferenze" class="responsive-hero-image" />
		</div>

		<section class="posts-section">
			<h2 class="section-title">Post recenti</h2>
			<div class="posts-grid">
				{latestPosts.map((post) => (
					<article class="post-card">
						<div class="post-content">
							<h3 class="post-title">
								<a href={post.url}>{post.frontmatter.title}</a>
							</h3>
							<p class="post-description">{post.frontmatter.description}</p>
							<div class="post-meta">
								<span class="read-more"><a href={post.url}>Leggi l'articolo →</a></span>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	body {
		background-color: #ffffff;
		margin: 0;
		color: #1a1a1a;
		-webkit-font-smoothing: antialiased;
	}

	.homepage-container {
		max-width: 680px; /* Larghezza Substack ottimale per la lettura */
		margin: 0 auto;
		padding: 3rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.intro-section {
		text-align: center;
	}

	h1 {
		font-family: Georgia, Cambria, serif;
		font-size: 2.8rem;
		font-weight: 700;
		margin: 0 0 0.8rem 0;
		letter-spacing: -1px;
	}

	.subtitle {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 1.15rem;
		line-height: 1.5;
		color: #666666;
		max-width: 540px;
		margin: 0 auto;
	}

	.hero-image-wrapper {
		width: 100%;
		overflow: hidden;
		border-radius: 8px;
		border: 1px solid #e5e7eb;
	}

	.responsive-hero-image {
		width: 100%;
		height: auto;
		max-height: 380px;
		object-fit: cover;
		display: block;
	}

	/* CSS PER LA SEZIONE ARTICOLI (STILE SUBSTACK) */
	.posts-section {
		border-top: 1px solid #e5e7eb; /* Linea divisoria orizzontale pulita */
		padding-top: 2rem;
	}

	.section-title {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 0.9rem;
		text-transform: uppercase; /* Scrittura in maiuscolo piccolo tipica di Substack */
		letter-spacing: 1px;
		color: #1a1a1a;
		margin-bottom: 1.5rem;
	}

	.posts-grid {
		display: block; /* Sviluppo verticale lineare dei post */
	}

	.post-card {
		border-bottom: 1px solid #f3f4f6; /* Linea sottile tra un articolo e l'altro */
		padding: 1.5rem 0;
	}

	.post-card:last-child {
		border-bottom: none; /* Rimuove la linea dall'ultimo articolo */
	}

	.post-title {
		font-family: Georgia, Cambria, serif;
		font-size: 1.4rem;
		margin: 0 0 0.5rem 0;
		line-height: 1.3;
	}

	.post-title a {
		color: #1a1a1a;
		text-decoration: none;
	}

	.post-title a:hover {
		color: #3b82f6; /* Accento blu moderno al passaggio del mouse */
	}

	.post-description {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		font-size: 1rem;
		color: #555555;
		line-height: 1.5;
		margin: 0 0 0.8rem 0;
	}

	.post-meta {
		font-size: 0.85rem;
	}

	.read-more a {
		color: #3b82f6;
		text-decoration: none;
		font-weight: 500;
	}

	.read-more a:hover {
		text-decoration: underline;
	}

	/* Ottimizzazione Smartphone */
	@media (max-width: 480px) {
		h1 { font-size: 2.2rem; }
		.subtitle { font-size: 1.05rem; }
		.post-title { font-size: 1.25rem; }
		.homepage-container { padding: 1.5rem 1rem; gap: 2rem; }
	}
</style>